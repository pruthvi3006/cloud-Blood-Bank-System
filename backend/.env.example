PORT=4000
JWT_SECRET=super-secret-jwt-key
AWS_REGION=ap-south-1
MEDICAL_REPORTS_BUCKET=your-medical-reports-bucket

# --- Database (MySQL) ---

# Local example:
# DATABASE_URL=mysql://root:yourpassword@127.0.0.1:3306/bloodbank

# Amazon RDS MySQL (replace host, user, password, database name):
# DATABASE_URL=mysql://admin:YOUR_PASSWORD@your-db.abc123xyz.us-east-1.rds.amazonaws.com:3306/bloodbank
# DATABASE_SSL=true

# If the password contains @ : / ? # encode it (e.g. @ -> %40). See docs/aws-rds-mysql.md

# Optional tuning:
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=15000
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
